# Team password for the web app (required to sign in)
HEADWIND_PASSWORD=
# SQLite file on persistent disk (default: ./data/headwind.db)
HEADWIND_DB=
# Split hosting: public pages on Vercel, the app on this server.
# Same random value on both sides; Vercel also sets HEADWIND_UPSTREAM to this server's URL.
HEADWIND_PROXY_KEY=
# On this server only: serve page files under /_hw so they load through the Vercel address
HEADWIND_ASSET_PREFIX=
# On Vercel only: this server's URL, e.g. https://54-164-50-152.sslip.io
HEADWIND_UPSTREAM=
# Model gateway (OpenAI-compatible)
LITELLM_BASE_URL=https://litellm.vision.aivar.app/v1
LiteLLM_API_KEY=
HEADWIND_MODEL=nova-micro
# Company evidence
CRUSTDATA_API_KEY=
# Financial scenarios (OAuth token file written by scripts/cfo-login)
CFO_TOKEN_FILE=
# Runtime traces
NEATLOGS_API_KEY=
NEATLOGS_ENDPOINT=https://ingest.neatlogs.com
